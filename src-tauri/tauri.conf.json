{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AssayPlot",
  "version": "0.7.5",
  "identifier": "org.assayplot.assayplot",
  "build": {
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev"
  },
  "app": {
    "windows": [
      {
        "title": "AssayPlot",
        "width": 1440,
        "height": 960,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "label": "main",
        "maximizable": true,
        "minimizable": true,
        "closable": true,
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "icons/document.ico": "document.ico"
    },
    "fileAssociations": [
      {
        "ext": [
          "asp"
        ],
        "name": "AssayPlot.Project",
        "description": "AssayPlot project",
        "role": "Editor",
        "mimeType": "application/x-assayplot"
      }
    ],
    "macOS": {
      "infoPlist": "Info.plist",
      "files": {
        "Resources/document.icns": "icons/document.icns"
      }
    },
    "windows": {
      "nsis": {
        "installerHooks": "windows/hooks.nsh"
      }
    },
    "linux": {
      "deb": {
        "files": {
          "/usr/share/mime/packages/assayplot.xml": "linux/assayplot-mime.xml",
          "/usr/share/icons/hicolor/256x256/mimetypes/application-x-assayplot.png": "icons/document.png"
        },
        "postInstallScript": "linux/refresh-mime.sh",
        "postRemoveScript": "linux/refresh-mime.sh"
      },
      "rpm": {
        "files": {
          "/usr/share/mime/packages/assayplot.xml": "linux/assayplot-mime.xml",
          "/usr/share/icons/hicolor/256x256/mimetypes/application-x-assayplot.png": "icons/document.png"
        },
        "postInstallScript": "linux/refresh-mime.sh",
        "postRemoveScript": "linux/refresh-mime.sh"
      }
    }
  }
}
