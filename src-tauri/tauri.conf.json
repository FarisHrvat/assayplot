{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AssayPlot",
  "version": "0.7.0",
  "identifier": "org.assayplot.assayplot",
  "build": {
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev"
  },
  "app": {
    "windows": [
      {
        "title": "AssayPlot",
        "width": 1440,
        "height": 960,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "label": "main",
        "maximizable": true,
        "minimizable": true,
        "closable": true,
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
